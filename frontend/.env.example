# Frontend env (Vite bakes these at BUILD time — rebuild after changing).
#
# VITE_API_URL is the API base (must include the /api suffix). The video-call
# WebSocket /signal URL is derived from the same host.
#
# Same-origin deploy (default): nginx proxies /api and /signal to the backend,
# so a relative base works and avoids CORS.
VITE_API_URL=/api
#
# Separate API host instead (e.g. two-server prod): point at the backend directly.
# VITE_API_URL=https://api.report.omt-mygutachter.com/api

# Use the DAT VIN-lookup mock instead of the real endpoint.
VITE_USE_MOCK=false
