# Copy to `.env` (git-ignored) and fill in real values, or export these in your shell
# before running the backend. Original values live in the source repos'
# application.properties / application.yml (my-gutachter-video-call, my-gutachter-report).

# Active Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=my_gutachter_internal

# DAT SOAP (VIN lookup)
DAT_CUSTOMER_NUMBER=
DAT_CUSTOMER_LOGIN=
DAT_CUSTOMER_PASSWORD=
DAT_INTERFACE_PARTNER_NUMBER=
DAT_INTERFACE_PARTNER_SIGNATURE=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mygutachter.com
MAILGUN_REGION=api.eu.mailgun.net
MAILGUN_FROM_EMAIL=Auftrag@mygutachter.com

# Twilio (SMS meeting invites — T4.1). Leave blank to disable SMS invites.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# OMT outbound API key (UVV CompleteUvvInspection / certificate fetch — T4.2).
# Leave blank to disable outbound OMT UVV calls. Real value lives in the VideoExpert
# source repo (app.quick-register.api-key).
OMT_API_KEY=

# OMT backend URL (dev profile). Defaults to the remote OMT dev/testing server
# when unset. To run against a locally-running OMT-Backend instead, set this to
# its ServerRootAddress, e.g. http://localhost:44311.
# OMT_DEV_BACKEND_URL=http://localhost:44311

# AWS S3 (unified file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_S3_BUCKET=video-xpert

# ---- Added in later tasks (T2.x JWT) ----
# JWT_SECRET=
# JWT_EXPIRATION=86400000

# Frontend base URL for password-reset links (T2.4)
APP_FRONTEND_URL=http://localhost:5174

# Backend base URL for absolute screenshot URLs (T4.1)
APP_BACKEND_URL=http://localhost:8080

# Inbound quick register API key from OMT (T7.x)
QUICK_REGISTER_API_KEY=sk_rCg1k6cltHZWQxnem4k1X2tWeKe5EtL4Zcx2OnwH
