# ---------------------------------------------------------------------------
# Root env for docker-compose. Copy to `.env` (git-ignored) and fill in secrets.
#   cp .env.example .env
# This file feeds BOTH the backend (env_file) and compose-level settings below.
# For running the backend jar directly (no compose), see backend/.env.example.
# ---------------------------------------------------------------------------

# ---- Compose / environment selection ----
# dev = OMT dev server, prod = OMT prod server (mirrors OMT's two-server layout).
SPRING_PROFILES_ACTIVE=dev
# Host port the app is served on (nginx). Open http://localhost:${FRONTEND_PORT}.
FRONTEND_PORT=8088
# Frontend API base baked at build time. `/api` = same-origin (nginx proxy).
VITE_API_URL=/api

# ---- MongoDB ----
# (MONGODB_URI is set by compose to the `mongo` service; only the db name here.)
MONGODB_DATABASE=my_gutachter_internal

# ---- JWT ----
# Base64 key, >= 256 bits. This is a DEV-ONLY default so `cp .env.example .env`
# boots; a blank value is NOT allowed (JJWT rejects it). CHANGE IN PROD.
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWNoYW5nZS1tZS1pbi1wcm9kLTAxMjM0NTY3ODlhYmNkZWZnaGlqa2xtbm9w
JWT_EXPIRATION=86400000

# ---- DAT SOAP (VIN lookup) ----
DAT_CUSTOMER_NUMBER=
DAT_CUSTOMER_LOGIN=
DAT_CUSTOMER_PASSWORD=
DAT_INTERFACE_PARTNER_NUMBER=
DAT_INTERFACE_PARTNER_SIGNATURE=

# ---- Mailgun ----
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mygutachter.com
MAILGUN_REGION=api.eu.mailgun.net
MAILGUN_FROM_EMAIL=Auftrag@mygutachter.com

# ---- Twilio (SMS meeting invites; blank = disabled) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# ---- AWS S3 (unified file storage) ----
# The S3 client is built at boot and rejects a BLANK access key, so these use
# non-blank `dummy` placeholders to let the stack boot. Presigning works offline,
# but real upload/download needs real credentials — replace for actual S3 use.
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=eu-central-1
AWS_S3_BUCKET=video-xpert

# ---- OMT outbound (UVV CompleteUvvInspection / certificate; blank = disabled) ----
OMT_API_KEY=

# ---- App URLs (used for reset links + absolute screenshot URLs) ----
# Point these at the public origin the browser uses (the nginx host).
APP_FRONTEND_URL=http://localhost:8088
APP_BACKEND_URL=http://localhost:8088
